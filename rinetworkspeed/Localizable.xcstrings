    "Wi-Fi": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi"
          }
        }
      }
    },
    "Wi-Fi Network Details": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi Ağ Ayrıntıları"
          }
        }
      }
    },
    "Wi-Fi Survey": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi Taraması"
          }
        }
      }
    },
    "Wi-Fi and cellular, with a monthly limit": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi ve hücresel, aylık limitle"
          }
        }
      }
    },
    "Wi-Fi names are recorded when location access is allowed. Tap a network to see only its tests.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi adları, konum erişimine izin verildiğinde kaydedilir. Yalnızca o ağın testlerini görmek için bir ağa dokunun."
          }
        }
      }
    },
    "Wi-Fi survey: %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi taraması: %@"
          }
        }
      }
    },
    "Wi-Fi: %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi: %@"
          }
        }
