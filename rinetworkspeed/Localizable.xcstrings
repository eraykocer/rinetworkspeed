    "Add" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekle"
          }
        }
      }
    },
    "Add “Open URLs” at the end and paste the address below. Replace each [name] with the matching action's result." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sona “URL'leri Aç” eylemini ekleyin ve aşağıdaki adresi yapıştırın. Her [ad] yerine ilgili eylemin sonucunu koyun."
          }
        }
      }
    },
    "Add a computer with its MAC address to turn it on from your iPhone. Wake-on-LAN must be enabled on the computer." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone'unuzdan açmak için bir bilgisayarı MAC adresiyle ekleyin. Bilgisayarda Wake-on-LAN açık olmalıdır."
          }
        }
      }
    },
    "Add a photo of your floor plan, or use a blank grid, then measure in different spots around your home." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kat planınızın fotoğrafını ekleyin ya da boş bir ızgara kullanın, sonra evinizin farklı noktalarında ölçüm yapın."
          }
        }
      }
    },
    "Add Device" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cihaz Ekle"
          }
        }
      }
    },
    "Add Room" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oda Ekle"
          }
        }
      }
    },
    "Add the action “Get Network Details” seven times. Set each to Wi-Fi and pick one detail per action: RSSI, Noise, Channel Number, Wi-Fi Standard, TX Rate, RX Rate and BSSID." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
