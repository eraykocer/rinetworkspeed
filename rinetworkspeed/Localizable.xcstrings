            "state": "translated",
            "value": "En Zayıf Nokta"
          }
        }
      }
    },
    "Websites load, but repeated connections fail. Restart the router and try again.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Web siteleri açılıyor ama tekrarlanan bağlantılar başarısız oluyor. Router'ı yeniden başlatıp tekrar deneyin."
          }
        }
