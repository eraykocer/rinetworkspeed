          }
        }
      }
    },
    "Tap Scan to discover devices on your local network." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yerel ağınızdaki cihazları keşfetmek için Tara'ya dokunun."
          }
        }
      }
    },
    "Tap to" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dokununca"
          }
        }
      }
    },
    "Tap where you stand on the plan; RiNetwork measures there and colours the map between your spots." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planda durduğunuz yere dokunun; RiNetwork orada ölçer ve noktalarınızın arasını haritada renklendirir."
          }
        }
      }
    },
    "Tap where your router is." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Router'ınızın olduğu yere dokunun."
          }
        }
      }
    },
    "Target" : {
      "comment" : "The name of the target.",
      "isCommentAutoGenerated" : true
    },
    "Target host (e.g. google.com)" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hedef sunucu (ör. google.com)"
          }
        }
      }
    },
    "TCP round trip to Amazon Web Services data centres, where many games host servers. Each game uses its own servers, so treat this as an estimate." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birçok oyunun sunucu barındırdığı Amazon Web Services veri merkezlerine TCP gidiş-dönüş süresi. Her oyun kendi sunucularını kullandığı için bunu bir tahmin olarak değerlendirin."
          }
        }
      }
    },
    "Technology" : {
      "localizations" : {
